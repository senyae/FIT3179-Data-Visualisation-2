{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "From pulp houses to multinationals",
        "subtitle": "Rank of the top 6 publishers of Australian novels in each decade, by number of novels. Hover a line to highlight it."
    },
    "width": "container",
    "height": 340,
    "data": {"url": "data/publisher_by_decade.csv",
             "format": {"parse": {"decade": "number", "count": "number"}}},
    "transform": [
        {"window": [{"op": "row_number", "as":"rank"}],
         "sort":[{"field":"count", "order":"descending"}],
         "groupby":["decade"]},
        {"filter":"datum.rank <= 6"},
        {"calculate": "datum.decade + 's'", "as": "decade_label"},
        {"calculate": "indexof(['Horwitz', 'Cleveland', 'Torstar','News Corporation', 'Pearson'],datum.publisher) >= 0 ? datum.publisher : 'Other Publishers'", "as": "group"}
    ],
    "encoding": {
        "x":{"field":"decade", "type": "quantitative", "title": null,
             "scale": {"domain": [1940, 2000]},
             "axis": {"values": [1940, 1950, 1960, 1970, 1980, 1990, 2000],
                      "labelExpr": "datum.value + 's'", "orient":"top", "grid": false, "domain": false}},
        "y":  {"field": "rank", "type": "quantitative", "title":"Rank",
                "scale": {"reverse": true, "domain":[1,6]},
                "axis":{"values": [1,2,3,4,5,6], "grid": false, "domain":false}},
        "color": {"field": "group", "type": "nominal", "legend":null,
                  "scale": {"domain": ["Horwitz", "Cleveland", "Torstar", "News Corporation", "Pearson", "Other Publishers"],
                            "range": ["#b45309","#ca8a04","#db2777","#1d4ed8","#16a34a","#d6d3d1"]}},
        "opacity": {"condition": {"param": "pub_hover","value":1, "empty":true}, "value": 0.2}
    },
    "layer": [
        {
            "params":[{"name": "pub_hover",
                        "select": {"type": "point", "fields":["publisher"], "on":"pointerover", "clear":"pointerout"}}],
                    "mark": {"type": "line", "strokeWidth": 3, "interpolate": "monotone"},
                    "encoding": {"detail": {"field": "publisher"}}
        },
        {
            "mark": {"type": "circle", "size": 110, "opacity": 1},
            "encoding": {
                "tooltip": [
                    {"field": "publisher", "title": "Publisher"},
                    {"field": "decade_label", "title": "Decade"},
                    {"field": "rank", "title": "Rank"},
                    {"field": "count", "title": "Novels"}
                ]
            }
        },
        {
            "transform": [
                {"filter": "datum.group != 'Other Publishers'"},
                {"joinaggregate": [{"op": "max", "field": "decade", "as":"last_decade"}], "groupby": ["publisher"]},
                {"filter": "datum.decade == datum.last_decade"}
                ],
                "mark": {"type": "text", "align":"left", "dx":10, "fontSize":12, "fontWeight": "bold"},
                "encoding": {"text": {"field":"publisher"}}
        }
    ]
}
